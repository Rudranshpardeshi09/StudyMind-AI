# ---------------------------------------------------------------- required
# Google Gemini API key (https://ai.google.dev/)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# JWT signing secret. REQUIRED in production and must be >= 32 characters.
# The server refuses to start without it when ENVIRONMENT=production.
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=

# ---------------------------------------------------------------- runtime
ENVIRONMENT=development          # set to "production" when deployed
AUTH_REQUIRED=true               # leave on; routes enforce auth regardless
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Where all mutable state lives: SQLite, uploads, per-user FAISS indexes.
# On Render this must point at a mounted persistent disk, or every deploy
# destroys all accounts and documents.
DATA_DIR=

# CORS: comma-separated origins (your Vercel URL plus local dev)
ALLOWED_ORIGINS=http://localhost:5173

# Google OAuth Web client ID (must match the frontend VITE_GOOGLE_CLIENT_ID)
GOOGLE_CLIENT_ID=

# ------------------------------------------------------------ rate limits
AUTH_RATE_LIMIT_PER_MINUTE=10    # per client IP on /auth/*
RATE_LIMIT_PER_MINUTE=0          # 0 disables; set e.g. 60 in production

# ---------------------------------------------------------------- tuning
CHUNK_SIZE=900
CHUNK_OVERLAP=150
TOP_K=6
MAX_CONTEXT_CHARS=4800
LEXICAL_WEIGHT=0.25              # lexical share of the blended rank score
MAX_CACHED_INDEXES=8             # per-user FAISS indexes held in memory
MAX_DOCUMENTS_PER_USER=50
MAX_FILE_SIZE=52428800

# Interactive API docs are closed in production unless this is set.
EXPOSE_DOCS=
